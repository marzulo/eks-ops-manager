# NOT FOR PRODUCTION USE. OpenSSL configuration file for testing.


[ req ]
default_bits = 4096
default_keyfile = myTestServerCertificateKey.pem    ## The default private key file name.
default_md = sha256
distinguished_name = req_dn
req_extensions = v3_req

[ v3_req ]
subjectKeyIdentifier  = hash
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
nsComment = "OpenSSL Generated Certificate for TESTING only.  NOT FOR PRODUCTION USE."
extendedKeyUsage  = serverAuth, clientAuth
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = *.svc.cluster.local
DNS.2 = *.rssearch-svc.mongodb.svc.cluster.local
DNS.3 = *.rssearch-search-0-svc.mongodb.svc.cluster.local
DNS.4 = rssearch-0
DNS.5 = rssearch-1
DNS.6 = rssearch-2
DNS.7 = rssearch-0.rssearch-svc.mongodb.svc.cluster.local
DNS.8 = rssearch-1.rssearch-svc.mongodb.svc.cluster.local
DNS.9 = rssearch-2.rssearch-svc.mongodb.svc.cluster.local
DNS.10 = rssearch-search-0-0
DNS.11 = rssearch-search-0-0.rssearch-search-0-svc.mongodb.svc.cluster.local
DNS.12 = *.eu-west-1.elb.amazonaws.com
DNS.13 = *.eu-central-1.elb.amazonaws.com

[ req_dn ]
countryName = Country Name (2 letter code)
countryName_default = IT
countryName_min = 2
countryName_max = 2

stateOrProvinceName = State or Province Name (full name)
stateOrProvinceName_default = Milano
stateOrProvinceName_max = 64

localityName = Locality Name (eg, city)
localityName_default = TestCertificateLocalityName
localityName_max = 64

organizationName = Organization Name (eg, company)
organizationName_default = MongoDB_ReplicaSet
organizationName_max = 64

organizationalUnitName = Organizational Unit Name (eg, section)
organizationalUnitName_default = ReplicaSet
organizationalUnitName_max = 64

commonName = Common Name (eg, YOUR name)
commonName_default = rssearch
commonName_max = 64
